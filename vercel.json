{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "headers": [
    {
      "source": "/rev.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
