---
import '../styles/global.css';
import HeadCommon from '../components/HeadCommon.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';
import { ui } from '../i18n/ui';
import { alternateOf, navKeyOf, other, routeKeyOf, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** This page in the other language; null = not translated. Omit for pages in the route map. */
  alternate?: string | null;
  noindex?: boolean;
  /** Override hreflang emission (case pages decide it with caseLinks). */
  hreflang?: boolean;
  /** RSS feed of this page (notes index). */
  rss?: string;
  /** Path of a 1200×630 PNG; defaults to the site card for the language. */
  ogImage?: string;
  /** article for case studies and notes. */
  ogType?: 'website' | 'article';
}
const {
  lang,
  title,
  description,
  alternate,
  noindex,
  hreflang,
  rss,
  ogImage = `/og/site/${lang}.png`,
  ogType = 'website',
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const currentKey = routeKeyOf(pathname);
const alt = alternateOf(pathname, alternate);
// hreflang only for a real twin, never for the home fallback.
const hasTwin =
  hreflang ?? (alternate !== undefined ? alternate !== null : currentKey !== undefined);
const byLang: Record<Lang, string> =
  lang === 'en' ? { en: pathname, es: alt ?? '' } : { en: alt ?? '', es: pathname };
const fullTitle = currentKey === 'home' ? `fmyers.dev — ${title}` : `${title} · fmyers.dev`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <HeadCommon title={fullTitle} description={description} noindex={noindex} />
    <link rel="canonical" href={site.url + pathname} />
    {rss && <link rel="alternate" type="application/rss+xml" title={title} href={site.url + rss} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? ui[lang].home.lead} />
    <meta property="og:url" content={site.url + pathname} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="fmyers.dev" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    {hasTwin && <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />}
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {hasTwin && (
      <>
        <link rel="alternate" hreflang={lang} href={site.url + byLang[lang]} />
        <link rel="alternate" hreflang={other(lang)} href={site.url + byLang[other(lang)]} />
        <link rel="alternate" hreflang="x-default" href={site.url + byLang.en} />
      </>
    )}
  </head>
  <body>
    <SiteNav lang={lang} currentKey={navKeyOf(pathname)} alternate={alt} />
    <main>
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
