---
import type { Lang } from '../i18n/routes';
import { asOf } from '../lib/work';

interface Props {
  items: { label: string; value: string; date: string }[];
  lang: Lang;
}
const { items, lang } = Astro.props;
---

{items.length > 0 && (
  <div class="metrics">
    <div class="grid">
      {items.map((m) => (
        <div class="cell">
          <span class="v">{m.value}</span>
          <span class="l">{m.label}</span>
        </div>
      ))}
    </div>
    <span class="as-of">{asOf(items, lang)}</span>
  </div>
)}

<style>
  .metrics {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    gap: 1px;
    background: var(--line);
    border: var(--border-ink);
  }
  .cell {
    background: var(--surface);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .v {
    font-stretch: var(--stretch-display);
    font-weight: 700;
    font-size: 36px;
    letter-spacing: -1px;
    line-height: 1;
  }
  .l {
    font-size: 14px;
    line-height: 1.35;
    color: var(--text-muted);
    text-wrap: pretty;
  }
  .as-of {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--text-muted);
  }
</style>
