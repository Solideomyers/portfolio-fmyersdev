---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    counter-reset: h2;
    max-width: var(--prose-max);
  }
  .prose :global(h2) {
    counter-increment: h2;
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin: clamp(36px, 4cqi, 48px) 0 0;
    font-stretch: var(--stretch-display);
    font-weight: 700;
    font-size: clamp(24px, 2.2cqi, 28px);
    letter-spacing: -0.5px;
    scroll-margin-top: 88px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h2)::before {
    content: counter(h2, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1px;
    font-stretch: 100%;
    color: var(--accent);
  }
  .prose :global(p) {
    margin: 14px 0 0;
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .prose :global(ul) {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .prose :global(li) {
    position: relative;
    padding-left: 26px;
    font-size: 17px;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .prose :global(li)::before {
    content: '—';
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(blockquote) {
    margin: 14px 0 0;
    padding-left: 20px;
    border-left: 2px solid var(--line-strong);
    font-size: clamp(19px, 1.8cqi, 22px);
    line-height: 1.45;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .prose :global(pre) {
    margin: 14px 0 0;
    padding: 16px;
    background: var(--surface);
    border: var(--border-rule);
    overflow-x: auto;
  }
  .prose :global(.figure) {
    margin-top: 22px;
  }
  .prose :global(.metrics) {
    margin-top: 14px;
  }
</style>
