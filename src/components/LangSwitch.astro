---
import { LANGS, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  alternate: string | null;
  size?: 'sm' | 'lg';
}
const { lang, alternate, size = 'sm' } = Astro.props;
---

<div class:list={['lang-switch', size]}>
  {LANGS.map((l) =>
    l === lang ? (
      <span class="cell on" aria-current="true" lang={l}>
        {l.toUpperCase()}
      </span>
    ) : alternate ? (
      <a class="cell" href={alternate} hreflang={l} lang={l} data-lang={l}>
        {l.toUpperCase()}
      </a>
    ) : (
      <span class="cell off" aria-disabled="true" lang={l}>
        {l.toUpperCase()}
      </span>
    ),
  )}
</div>

<script>
  // D07: switching language keeps the reading position. The twin pages share their section
  // structure but not their text length, so the position is "section index + offset into it".
  const KEY = 'fm-lang-swap';
  const blocks = () => [...document.querySelectorAll<HTMLElement>('main section')];

  for (const a of document.querySelectorAll<HTMLAnchorElement>('.lang-switch a[data-lang]')) {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('lang', a.dataset.lang ?? 'en');
      } catch {
        // storage blocked: the link still navigates
      }
      let index = -1;
      let offset = 0;
      blocks().forEach((el, i) => {
        const r = el.getBoundingClientRect();
        // the last match is the innermost section crossing the viewport top
        if (r.top <= 0 && r.bottom > 0) {
          index = i;
          offset = -r.top;
        }
      });
      try {
        if (index >= 0) sessionStorage.setItem(KEY, JSON.stringify({ index, offset }));
      } catch {
        // storage blocked: the twin opens at the top
      }
    });
  }

  try {
    const saved = sessionStorage.getItem(KEY);
    if (saved) {
      sessionStorage.removeItem(KEY);
      const { index, offset } = JSON.parse(saved) as { index: number; offset: number };
      const el = blocks()[index];
      if (el)
        scrollTo(
          0,
          el.getBoundingClientRect().top + scrollY + Math.min(offset, el.offsetHeight - 1),
        );
    }
  } catch {
    // storage blocked or bad value: stay at the top
  }
</script>

<style>
  .lang-switch {
    display: flex;
    border: var(--border-ink);
  }
  .cell {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 7px 10px;
    color: var(--text);
    text-decoration: none;
  }
  .lg .cell {
    font-size: 13px;
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0 14px;
  }
  .on {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }
  .off {
    color: var(--text-muted);
  }
</style>
